# Copy to .env and fill in. Never commit .env.

# LiveKit: a LiveKit Cloud project, or a local `livekit-server --dev`
# (then LIVEKIT_URL=ws://localhost:7880, LIVEKIT_API_KEY=devkey, LIVEKIT_API_SECRET=secret).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI key used by the example agent's realtime model.
OPENAI_API_KEY=

# MeshLite console: a test publishable key and a test secret key ("API keys"),
# and the avatar id ("Integration").
MESHLITE_PUBLISHABLE_KEY=ml_pk_test_...
MESHLITE_SECRET_KEY=ml_sk_test_...
MESHLITE_AVATAR=

# Address of the demo page; declare it as a test domain in the MeshLite console ("Domains").
PUBLIC_ORIGIN=http://localhost:8080
