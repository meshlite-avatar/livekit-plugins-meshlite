# Copy to .env and fill in. Never commit .env.

# Model of the example bot (realtime voice model). Fill in ONE of the two blocks.
# 1) OpenAI:
OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime
# 2) Azure OpenAI instead: uncomment the three lines (when AZURE_OPENAI_ENDPOINT is set, Azure is used).
#    The deployment is the name you gave your realtime model in the Azure portal.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-realtime

# MeshLite Console (Projects, For developers): a test publishable key and a test secret key
# (tab "Keys") and the avatar id (tab "Code").
MESHLITE_PUBLISHABLE_KEY=ml_pk_test_...
MESHLITE_SECRET_KEY=ml_sk_test_...
MESHLITE_AVATAR=

# Address of the demo page; add it in the MeshLite Console as a test site (tab "Allowed sites").
PUBLIC_ORIGIN=http://localhost:8080
